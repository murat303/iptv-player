<brls:Box
        width="auto"
        height="auto"
        marginBottom="@style/tsvitch/setting/about/bottom">
    <brls:Box
            grow="1.0"
            width="auto"
            height="auto"
            axis="column"
            hideHighlightBackground="true"
            hideHighlightBorder="true"
            wireframe="false"
            paddingLeft="@style/brls/tab_frame/content_padding_sides"
            paddingRight="@style/brls/tab_frame/content_padding_sides"
            paddingTop="@style/tsvitch/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/tsvitch/tab_frame/content_padding_top_bottom">
        <brls:Box
                justifyContent="center"
                alignItems="flexEnd"
                marginBottom="@style/tsvitch/margin/20">
            <brls:Label
                    fontSize="60"
                    marginRight="10"
                    lineHeight="1"
                    text="IPTV Player"/>
            <brls:Label
                    id="setting/about/version"
                    marginRight="20"
                    lineHeight="1"
                    textColor="@theme/font/grey"/>
        </brls:Box>
        <brls:Header
                title="@i18n/tsvitch/setting/about/brief_header"
                marginBottom="@style/tsvitch/margin/20"/>
        <brls:Label
                marginLeft="20"
                marginBottom="@style/tsvitch/margin/20"
                text="@i18n/tsvitch/setting/about/brief"/>
        <brls:Header
                title="@i18n/tsvitch/setting/about/developer_header"
                marginBottom="@style/tsvitch/margin/20"/>
        <brls:Label
                marginLeft="20"
                marginBottom="@style/tsvitch/margin/20"
                text="muratgokce"/>
        <brls:Header
                title="@i18n/tsvitch/setting/about/credits_header"
                marginBottom="@style/tsvitch/margin/20"/>
        <brls:Label
                marginLeft="20"
                marginBottom="@style/tsvitch/margin/20"
                text="@i18n/tsvitch/setting/about/credits"/>
        <brls:Header
                title="@i18n/tsvitch/setting/about/data_header"
                marginBottom="@style/tsvitch/margin/20"/>
        <SVGImage
                width="164"
                height="21"
                marginLeft="20"
                marginBottom="12"
                SVG="@res/svg/tmdb-logo.svg"/>
        <brls:Label
                marginLeft="20"
                marginBottom="@style/tsvitch/margin/20"
                text="@i18n/tsvitch/setting/about/data"/>
        <brls:Header
                title="@i18n/tsvitch/setting/about/license_header"
                marginBottom="@style/tsvitch/margin/20"/>
        <brls:Label
                marginLeft="20"
                marginBottom="@style/tsvitch/margin/20"
                text="@i18n/tsvitch/setting/about/license"/>
    </brls:Box>
</brls:Box>
