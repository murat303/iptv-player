<brls:Box
        axis="row"
        width="auto"
        marginTop="10"
        height="auto">
        <brls:Box
                id="xtream/left/column"
                axis="column"
                width="270"
                height="auto">
                <CustomButton
                        id="xtream/content/back"
                        focusable="true"
                        highlightCornerRadius="6"
                        cornerRadius="6"
                        width="250"
                        height="36"
                        marginTop="20"
                        marginLeft="10"
                        marginRight="10"
                        paddingLeft="12"
                        paddingRight="12"
                        visibility="gone"
                        alignItems="center"
                        justifyContent="spaceBetween"
                        backgroundColor="@theme/color/grey_1">
                        <brls:Label
                                id="xtream/content/back/label"
                                fontSize="16"
                                text="@i18n/tsvitch/xtream/content/live" />
                        <brls:Box
                                axis="row"
                                width="auto"
                                height="auto"
                                alignItems="center">
                                <brls:Label
                                        fontSize="16"
                                        marginRight="6"
                                        text="←" />
                                <brls:Label
                                        fontSize="16"
                                        text="@i18n/hints/back" />
                        </brls:Box>
                </CustomButton>
                <RecyclingGrid
                        grow="1"
                        width="auto"
                        paddingLeft="10"
                        paddingRight="10"
                        marginTop="8"
                        marginBottom="8"
                        itemHeight="60"
                        preFetchLine="2"
                        spanCount="1"
                        wireframe="false"
                        lineColor="@theme/color/line"
                        lineRight="1"
                        id="dynamic/up/recyclingGrid" />
        </brls:Box>
        <!-- Right side: the buttons above the grid (reachable with Up from the first row) -->
        <brls:Box
                axis="column"
                grow="1"
                height="auto">
        <brls:Box
                width="100%"
                height="70"
                axis="row"
                justifyContent="flexEnd"
                alignItems="center"
                wireframe="false">
                <CustomButton
                        id="home/sort"
                        focusable="true"
                        highlightCornerRadius="6"
                        hideHighlightBackground="true"
                        width="210"
                        height="35"
                        marginRight="10"
                        backgroundColor="#E3E5E7"
                        paddingLeft="15"
                        cornerRadius="6"
                        alignItems="center"
                        visibility="gone">
                        <brls:Label
                                id="home/sort/label"
                                fontSize="14"
                                singleLine="true"
                                textColor="#18191c"/>
                </CustomButton>
                <CustomButton
                        id="home/refresh"
                        focusable="true"
                        highlightCornerRadius="6"
                        hideHighlightBackground="true"
                        width="180"
                        height="35"
                        marginRight="10"
                        backgroundColor="#E3E5E7"
                        paddingLeft="15"
                        cornerRadius="6"
                        alignItems="center">
                        <brls:Label
                                id="home/refresh/label"
                                fontSize="14"
                                textColor="#18191c"
                                text="@i18n/tsvitch/xtream/action/refresh" />
                </CustomButton>
                <CustomButton
                        id="home/search"
                        focusable="true"
                        highlightCornerRadius="8"
                        hideHighlightBackground="true"
                        width="300"
                        height="35"
                        backgroundColor="#E3E5E7"
                        paddingLeft="15"
                        cornerRadius="6">
                        <brls:Label
                                id="home/search/label"
                                fontSize="14"
                                textColor="#18191c"
                                text="@i18n/tsvitch/home/common/search" />
                        <HintLabel
                                height="35"
                                positionType="absolute"
                                positionRight="15"
                                fontSize="14"
                                textColor="#18191c"
                                text="y" />
                </CustomButton>
        </brls:Box>
        <RecyclingGrid
                paddingLeft="20"
                paddingRight="20"
                grow="1"
                spanCount="@style/tsvitch/grid/span/4"
                itemHeight="200"
                wireframe="false"
                preFetchLine="2"
                id="home/live/recyclingGrid" />
        <!-- While a list comes from the provider: a turning ring and what is happening -->
        <brls:Box
                id="home/live/loading"
                positionType="absolute"
                positionLeft="0"
                positionTop="0"
                width="100%"
                height="100%"
                justifyContent="center"
                alignItems="center"
                visibility="gone">
                <brls:Box
                        axis="column"
                        width="560"
                        height="auto"
                        alignItems="center"
                        paddingTop="30"
                        paddingBottom="28"
                        paddingLeft="36"
                        paddingRight="36"
                        cornerRadius="18"
                        backgroundColor="@theme/brls/backdrop">
                        <LoadingRing
                                width="60"
                                height="60"
                                marginBottom="20" />
                        <brls:Label
                                id="home/live/loading/title"
                                width="100%"
                                fontSize="24"
                                textColor="#FFFFFF"
                                horizontalAlign="center" />
                        <brls:Label
                                id="home/live/loading/detail"
                                width="100%"
                                fontSize="18"
                                marginTop="10"
                                textColor="#FFFFFFD0"
                                horizontalAlign="center" />
                        <brls:Box
                                id="home/live/loading/bar"
                                width="100%"
                                height="6"
                                marginTop="18"
                                cornerRadius="3"
                                backgroundColor="#FFFFFF30"
                                visibility="gone">
                                <brls:Box
                                        id="home/live/loading/bar/fill"
                                        width="0"
                                        height="6"
                                        cornerRadius="3"
                                        backgroundColor="#FF9100" />
                        </brls:Box>
                        <brls:Label
                                width="100%"
                                fontSize="15"
                                marginTop="18"
                                textColor="#FFFFFF90"
                                horizontalAlign="center"
                                text="@i18n/tsvitch/xtream/loading/hint" />
                </brls:Box>
        </brls:Box>
        </brls:Box>

        <brls:Box
                id="xtream/hub"
                positionType="absolute"
                positionLeft="0"
                positionTop="0"
                width="100%"
                height="100%"
                axis="row"
                justifyContent="center"
                alignItems="center"
                visibility="gone">
                <CustomButton
                        id="xtream/hub/live"
                        focusable="true"
                        highlightCornerRadius="10"
                        cornerRadius="10"
                        width="220"
                        height="260"
                        margin="15"
                        justifyContent="center"
                        alignItems="center"
                        backgroundColor="@theme/color/grey_1">
                        <brls:Label
                                fontSize="22"
                                horizontalAlign="center"
                                text="@i18n/tsvitch/xtream/content/live" />
                </CustomButton>
                <CustomButton
                        id="xtream/hub/movies"
                        focusable="true"
                        highlightCornerRadius="10"
                        cornerRadius="10"
                        width="220"
                        height="260"
                        margin="15"
                        justifyContent="center"
                        alignItems="center"
                        backgroundColor="@theme/color/grey_1">
                        <brls:Label
                                fontSize="22"
                                horizontalAlign="center"
                                text="@i18n/tsvitch/xtream/content/movies" />
                </CustomButton>
                <CustomButton
                        id="xtream/hub/series"
                        focusable="true"
                        highlightCornerRadius="10"
                        cornerRadius="10"
                        width="220"
                        height="260"
                        margin="15"
                        justifyContent="center"
                        alignItems="center"
                        backgroundColor="@theme/color/grey_1">
                        <brls:Label
                                fontSize="22"
                                horizontalAlign="center"
                                text="@i18n/tsvitch/xtream/content/series" />
                </CustomButton>
        </brls:Box>

</brls:Box>
