<brls:Box
        width="auto"
        height="auto"
        axis="column"
        grow="1">

    <!-- How far the TMDB data of the catalogue is (a line above the page, gone when there is nothing to say) -->
    <brls:Label
            id="discover/status"
            alignSelf="flexEnd"
            marginTop="6"
            marginRight="34"
            fontSize="14"
            textColor="@theme/font/grey"
            visibility="gone" />

    <brls:ScrollingFrame
            id="discover/scroll"
            width="100%"
            grow="1"
            scrollingBehavior="centered">
        <brls:Box
                id="discover/content"
                width="100%"
                height="auto"
                axis="column"
                paddingBottom="40" />
    </brls:ScrollingFrame>

    <!-- Nothing to show yet: why, with a ring while something loads -->
    <brls:Box
            id="discover/message"
            positionType="absolute"
            positionLeft="0"
            positionTop="0"
            width="100%"
            height="100%"
            axis="column"
            justifyContent="center"
            alignItems="center"
            visibility="gone">
        <LoadingRing
                id="discover/message/ring"
                width="54"
                height="54"
                marginBottom="20" />
        <brls:Label
                id="discover/message/label"
                width="600"
                fontSize="19"
                horizontalAlign="center"
                textColor="@theme/font/grey" />
    </brls:Box>
</brls:Box>
