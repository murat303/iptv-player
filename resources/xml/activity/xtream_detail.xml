<brls:AppletFrame
        iconInterpolation="linear"
        backgroundColor="@theme/brls/background"
        headerHidden="true"
        footerHidden="false">

    <brls:Box
            width="100%"
            height="100%">

        <!-- Wide picture of the movie/series behind everything, darkened so the text stays readable -->
        <brls:Image
                id="detail/backdrop"
                positionType="absolute"
                positionLeft="0"
                positionTop="0"
                width="100%"
                height="100%"
                scalingType="fill"/>
        <brls:Rectangle
                positionType="absolute"
                positionLeft="0"
                positionTop="0"
                width="100%"
                height="100%"
                color="#16171BE0"/>

        <brls:Box
                width="100%"
                height="100%"
                axis="row"
                paddingTop="36"
                paddingLeft="56"
                paddingRight="56"
                paddingBottom="12">

        <brls:Box
                axis="column"
                width="250"
                height="auto"
                shrink="0">
            <brls:Box
                    width="250"
                    height="375">
                <brls:Image
                        id="detail/poster"
                        width="250"
                        height="375"
                        cornerRadius="10"
                        scalingType="fill"
                        backgroundColor="@theme/color/grey_1"/>
                <!-- How far the movie was played -->
                <ProgressLine
                        id="detail/poster/progress"
                        positionType="absolute"
                        positionLeft="12"
                        positionRight="12"
                        positionBottom="10"
                        height="5"
                        visibility="gone"/>
            </brls:Box>
            <brls:Label
                    id="detail/facts"
                    width="250"
                    marginTop="14"
                    fontSize="15"
                    textColor="#B4B9C2"/>
        </brls:Box>

        <brls:Box
                axis="column"
                grow="1"
                height="100%"
                marginLeft="40">
            <TextBox
                    id="detail/title"
                    fontSize="30"
                    textColor="#FFFFFF"
                    maxRows="2"
                    width="100%"/>
            <brls:Label
                    id="detail/subtitle"
                    fontSize="16"
                    marginTop="4"
                    textColor="#B4B9C2"
                    visibility="gone"/>
            <brls:Box
                    axis="row"
                    alignItems="center"
                    marginTop="10">
                <brls:Box
                        id="detail/watched"
                        height="28"
                        paddingLeft="7"
                        paddingRight="10"
                        marginRight="12"
                        cornerRadius="6"
                        alignItems="center"
                        backgroundColor="#FFFFFF1F"
                        visibility="gone">
                    <SVGImage
                            width="18"
                            height="18"
                            marginRight="6"
                            SVG="@res/svg/ico-watched.svg"/>
                    <brls:Label
                            fontSize="16"
                            textColor="#FFFFFF"
                            text="@i18n/tsvitch/detail/watched"/>
                </brls:Box>
                <brls:Box
                        id="detail/rating/box"
                        height="28"
                        paddingLeft="10"
                        paddingRight="10"
                        marginRight="12"
                        cornerRadius="6"
                        alignItems="center"
                        backgroundColor="@theme/color/yellow_1"
                        visibility="gone">
                    <brls:Label
                            id="detail/rating"
                            fontSize="17"
                            textColor="@theme/font/yellow_1"/>
                </brls:Box>
                <brls:Label
                        id="detail/meta"
                        fontSize="17"
                        textColor="#C8CCD2"/>
            </brls:Box>

            <brls:Box
                    axis="row"
                    alignItems="center"
                    marginTop="22">
                <CustomButton
                        id="detail/play"
                        focusable="true"
                        height="48"
                        paddingLeft="22"
                        paddingRight="22"
                        marginRight="14"
                        cornerRadius="8"
                        highlightCornerRadius="8"
                        hideHighlightBackground="true"
                        alignItems="center"
                        backgroundColor="@theme/color/tsvitch">
                    <brls:Label
                            id="detail/play/label"
                            fontSize="18"
                            textColor="#FFFFFF"/>
                </CustomButton>
                <CustomButton
                        id="detail/restart"
                        focusable="true"
                        height="48"
                        paddingLeft="20"
                        paddingRight="20"
                        marginRight="14"
                        cornerRadius="8"
                        highlightCornerRadius="8"
                        hideHighlightBackground="true"
                        alignItems="center"
                        backgroundColor="#FFFFFF26"
                        visibility="gone">
                    <brls:Label
                            fontSize="18"
                            textColor="#FFFFFF"
                            text="@i18n/tsvitch/detail/restart"/>
                </CustomButton>
                <CustomButton
                        id="detail/favorite"
                        focusable="true"
                        height="48"
                        paddingLeft="20"
                        paddingRight="20"
                        cornerRadius="8"
                        highlightCornerRadius="8"
                        hideHighlightBackground="true"
                        alignItems="center"
                        backgroundColor="#FFFFFF26">
                    <brls:Label
                            id="detail/favorite/label"
                            fontSize="18"
                            textColor="#FFFFFF"/>
                </CustomButton>
                <CustomButton
                        id="detail/download"
                        focusable="true"
                        height="48"
                        paddingLeft="20"
                        paddingRight="20"
                        marginLeft="14"
                        cornerRadius="8"
                        highlightCornerRadius="8"
                        hideHighlightBackground="true"
                        alignItems="center"
                        backgroundColor="#FFFFFF26">
                    <brls:Label
                            fontSize="18"
                            textColor="#FFFFFF"
                            text="@i18n/tsvitch/detail/download"/>
                </CustomButton>
            </brls:Box>

            <TextBox
                    id="detail/plot"
                    fontSize="17"
                    textColor="#E6E8EB"
                    lineHeight="1.35"
                    marginTop="22"
                    maxRows="7"
                    width="100%"/>
            <TextBox
                    id="detail/director"
                    fontSize="15"
                    marginTop="14"
                    maxRows="1"
                    width="100%"
                    textColor="#B4B9C2"/>
            <TextBox
                    id="detail/cast"
                    fontSize="15"
                    marginTop="6"
                    maxRows="2"
                    width="100%"
                    textColor="#B4B9C2"/>

            <!-- From TMDB (movies): the director and the cast with photos, and similar titles of the catalogue -->
            <brls:Box
                    id="detail/people"
                    axis="row"
                    width="100%"
                    marginTop="16"
                    visibility="gone"/>
            <brls:Box
                    id="detail/similar"
                    axis="column"
                    width="100%"
                    visibility="gone"/>

            <!-- Series: season picker and the episodes of the chosen season -->
            <brls:Box
                    id="detail/series"
                    axis="column"
                    grow="1"
                    marginTop="16"
                    visibility="gone">
                <!-- One button per season, scrolling sideways when there are many -->
                <brls:Box
                        axis="row"
                        alignItems="center"
                        width="100%"
                        height="50">
                    <!-- L and R change the season; their hints live here, the footer has no room -->
                    <brls:Label
                            id="detail/seasons/prev"
                            fontSize="26"
                            marginRight="12"
                            textColor="#FFFFFF"
                            visibility="gone"/>
                    <brls:HScrollingFrame
                            id="detail/seasons/scroll"
                            grow="1"
                            height="50">
                        <brls:Box
                                id="detail/seasons"
                                axis="row"
                                width="auto"
                                height="auto"
                                alignItems="center"
                                paddingTop="4"
                                paddingBottom="4"/>
                    </brls:HScrollingFrame>
                    <brls:Label
                            id="detail/seasons/next"
                            fontSize="26"
                            marginLeft="12"
                            textColor="#FFFFFF"
                            visibility="gone"/>
                </brls:Box>
                <RecyclingGrid
                        id="detail/episodes"
                        grow="1"
                        marginTop="10"
                        spanCount="1"
                        itemHeight="104"
                        itemSpace="8"
                        preFetchLine="2"
                        wireframe="false"/>
            </brls:Box>
        </brls:Box>
        </brls:Box>
    </brls:Box>
</brls:AppletFrame>
