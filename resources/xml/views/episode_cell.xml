<brls:Box
        width="auto"
        height="auto"
        axis="row"
        alignItems="center"
        paddingLeft="8"
        paddingRight="12"
        cornerRadius="8"
        highlightCornerRadius="8"
        hideHighlightBackground="true"
        backgroundColor="#FFFFFF10"
        focusable="true">

    <brls:Box
            width="170"
            height="96"
            shrink="0">
        <brls:Image
                id="episode/still"
                width="170"
                height="96"
                cornerRadius="6"
                scalingType="fill"
                backgroundColor="@theme/color/grey_1"/>
        <brls:Box
                id="episode/resume"
                positionType="absolute"
                positionRight="6"
                positionBottom="6"
                height="22"
                paddingLeft="6"
                paddingRight="6"
                cornerRadius="4"
                alignItems="center"
                backgroundColor="#000000B0"
                visibility="gone">
            <brls:Label
                    id="episode/resume/label"
                    fontSize="13"
                    textColor="#FFFFFF"/>
        </brls:Box>
    </brls:Box>

    <brls:Box
            axis="column"
            grow="1"
            marginLeft="16"
            justifyContent="center">
        <brls:Label
                id="episode/title"
                fontSize="18"
                singleLine="true"
                textColor="#FFFFFF"/>
        <brls:Label
                id="episode/meta"
                fontSize="14"
                marginTop="3"
                textColor="#B4B9C2"/>
        <TextBox
                id="episode/plot"
                fontSize="14"
                marginTop="4"
                maxRows="2"
                width="100%"
                textColor="#B4B9C2"/>
    </brls:Box>
</brls:Box>
