<brls:Box
        width="100%"
        height="120"
        axis="row"
        alignItems="center"
        paddingLeft="12"
        paddingRight="24"
        cornerRadius="10"
        highlightCornerRadius="10"
        backgroundColor="#FFFFFF0D">

    <brls:Image
            id="download_item/image"
            width="68"
            height="100"
            shrink="0"
            cornerRadius="6"
            scalingType="fill"
            backgroundColor="@theme/color/grey_1"/>

    <brls:Box
            axis="column"
            width="0"
            grow="1"
            marginLeft="20"
            justifyContent="center">

        <brls:Label
                id="download_item/title"
                width="100%"
                fontSize="21"
                singleLine="true"
                textColor="@theme/brls/text"/>

        <brls:Box
                width="100%"
                axis="row"
                alignItems="center"
                marginTop="8">
            <brls:Label
                    id="download_item/status"
                    shrink="0"
                    fontSize="17"
                    singleLine="true"/>
            <brls:Label
                    id="download_item/detail"
                    width="0"
                    grow="1"
                    fontSize="16"
                    marginLeft="14"
                    singleLine="true"
                    textColor="@theme/brls/text_disabled"/>
        </brls:Box>

        <brls:Box
                id="download_item/bar"
                width="100%"
                height="8"
                marginTop="12"
                cornerRadius="4"
                backgroundColor="#8080803A">
            <brls:Box
                    id="download_item/bar/fill"
                    width="0"
                    height="8"
                    cornerRadius="4"
                    backgroundColor="#FF9100"/>
        </brls:Box>
    </brls:Box>
</brls:Box>
